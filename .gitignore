node_modules/
dist/
data/
*.tsbuildinfo
.wrangler/
.dev.vars

# secrets — never commit
.env
.env.*
*.pat

# Generated by `npm run build --workspace @solawi/web`.
# Ignored, but the directory itself is tracked via .gitkeep so wrangler never
# sees a missing assets dir, and scripts/check-assets.mjs fails the deploy if
# the bundle is absent.
packages/server-cf/public/*
!packages/server-cf/public/.gitkeep
