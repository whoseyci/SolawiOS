{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": false, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["src/**/*"]
}
